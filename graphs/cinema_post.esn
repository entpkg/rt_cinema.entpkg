//! Standalone Post-TAA Filmic Finish Stack (`Image` linear HDR + depth-in-w -> Optical Bokeh DOF
//! -> Wide-Halo Bloom -> Exposure-Invariant Sharpening + AgX/ACES Grade -> FXAA)!
//! Ideal for action games that composite fast volumetric fire, rain streaks, ballistic sparks &
//! weapon slash ribbons AFTER temporal resolve (`camera.tsr@2` or `rt_cinema.taa_resolve_dynamic@1`)
//! so fast VFX never suffer temporal ghosting while still receiving cinema Bokeh DOF, Bloom & Grade!
use "../kernels/";
use "image.entpkg";

input hdr: Image;

param far: Float = 265.0;
param exposure: Float = 1.12;
param bloom_threshold: Float = 2.0;
param bloom_amount: Float = 0.16;
param dof_near: Float = 2.0;
param dof_far: Float = 160.0;
param dof_strength: Float = 0.85;
param sharpen: Float = 0.28;
param saturation: Float = 1.11;
param contrast: Float = 0.09;
param shadow_tint: Vec3 = vec3(0.94, 0.98, 1.03);
param highlight_tint: Vec3 = vec3(1.03, 1.01, 0.96);
param vignette: Float = 0.085;
param grain: Float = 0.007;
param encode_srgb: Int = 0;
param tone_mode: Int = 0;
param toe_power: Float = 1.0;

node half_dof: image.shrink@1 {
    source <- hdr;
    domain = max(min(ceil(size(source) / 2), vec2(640, 400)), vec2(1, 1));
}
node soft_dof: graph "image.entpkg/graphs/blur.esn" {
    source <- half_dof.result;
    sigma = 3.4;
}

node bright: rt_cinema.bright_pass@1 {
    source <- hdr;
    threshold = bloom_threshold;
    far = far;
    domain = max(min(ceil(size(source) / 2), vec2(640, 400)), vec2(1, 1));
}
node bloom: graph "image.entpkg/graphs/blur.esn" {
    source <- bright.result;
    sigma = 3.2;
}

node graded: rt_cinema.cinema_grade@1 {
    hdr <- hdr;
    soft_dof <- soft_dof.result;
    bloom <- bloom.result;
    exposure = exposure;
    bloom_amount = bloom_amount;
    dof_near = dof_near;
    dof_far = dof_far;
    dof_strength = dof_strength;
    sharpen = sharpen;
    saturation = saturation;
    contrast = contrast;
    shadow_tint = shadow_tint;
    highlight_tint = highlight_tint;
    vignette = vignette;
    grain = grain;
    encode_srgb = encode_srgb;
    tone_mode = tone_mode;
    toe_power = toe_power;
    far = far;
    domain = size(hdr);
}

node final_view: image.fxaa@1 {
    image <- graded.result;
    subpixel = 0.28;
    domain = size(image);
}

output result <- final_view.result;
