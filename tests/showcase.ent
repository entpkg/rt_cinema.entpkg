// Self-contained showcase scene exercising every kernel & sub-graph in `rt_cinema.entpkg`:
//   - Zero-Asset 16x Anisotropic Auto-Mipmap PBR (Granite, Concrete, Cyber-Steel)
//   - Multi-Mesh Hardware RT Soft Sun Shadows (`graphs/rt_shadows.esn`)
//   - Half-Res SHADER_F16 GTAO + Contact Shadows (`graphs/gtao.esn`)
//   - 3D Expanding World Wavefront + 4-Layer Volumetric Sky + Forked Lightning
//   - Drop-In Zero-Flicker TAA + Bokeh DOF + Bloom + AgX + FXAA (`graphs/cinema_finish.esn`)
use "random.entpkg";
use "geometry.entpkg";
use "raster.entpkg";
use "rt_cinema.entpkg";

struct DemoBox {
    center: Vec3;
    half: Vec3;
    mat: Int;
}

fn demo_box(i: Int) -> DemoBox {
    if i == 0 {
        return DemoBox { center: vec3(0.0, -0.5, 0.0), half: vec3(18.0, 0.5, 18.0), mat: 0 }; // Concrete plaza floor
    }
    if i == 1 {
        return DemoBox { center: vec3(0.0, 1.8, -4.5), half: vec3(1.1, 1.8, 0.7), mat: 2 }; // Central cyber-steel monolith
    }
    if i == 2 {
        return DemoBox { center: vec3(-3.2, 0.9, -2.5), half: vec3(0.95, 0.9, 0.95), mat: 1 }; // Chiseled granite pillar
    }
    if i == 3 {
        return DemoBox { center: vec3(3.1, 1.2, -3.2), half: vec3(0.85, 1.2, 0.85), mat: 1 }; // Second granite block
    }
    if i == 4 {
        return DemoBox { center: vec3(-1.4, 0.45, -1.2), half: vec3(0.45, 0.45, 0.45), mat: 2 }; // Foreground steel cube
    }
    return DemoBox { center: vec3(2.2, 0.55, -0.8), half: vec3(0.55, 0.55, 0.55), mat: 0 }; // Foreground concrete plinth
}

fn box_face_vertex(b: DemoBox, f: Int, c: Int) -> Vec3 {
    let sx = if c == 1 || c == 2 { 1.0 } else { -1.0 };
    let sy = if c == 2 || c == 3 { 1.0 } else { -1.0 };
    let p = if f == 0 {
        vec3(sx, sy, 1.0)
    } else if f == 1 {
        vec3(-sx, sy, -1.0)
    } else if f == 2 {
        vec3(1.0, sy, -sx)
    } else if f == 3 {
        vec3(-1.0, sy, sx)
    } else if f == 4 {
        vec3(sx, 1.0, -sy)
    } else {
        vec3(sx, -1.0, sy)
    };
    return b.center + p * b.half;
}

fn box_face_normal(f: Int) -> Vec3 {
    if f == 0 { return vec3(0.0, 0.0, 1.0); }
    if f == 1 { return vec3(0.0, 0.0, -1.0); }
    if f == 2 { return vec3(1.0, 0.0, 0.0); }
    if f == 3 { return vec3(-1.0, 0.0, 0.0); }
    if f == 4 { return vec3(0.0, 1.0, 0.0); }
    return vec3(0.0, -1.0, 0.0);
}

kernel rt_demo.lens@1 {
    requires { field.write; time.read; }
    output result: Rows<Lens>;

    compute {
        let t = time();
        let eye = vec3(sin(t * 0.35) * 2.2, 2.35, 5.2);
        let ahead = normalize(vec3(0.0, 1.0, -3.2) - eye);
        let right = normalize(cross(ahead, vec3(0.0, 1.0, 0.0)));
        let up = cross(right, ahead);
        return Lens { eye: eye, ahead: ahead, right: right, up: up, focal: 1.35 };
    }
}

kernel rt_demo.verts@1 {
    requires { field.write; }
    output result: Rows<Vec3>;

    compute {
        let vid = element();
        let qid = vid / 4;
        let cid = vid % 4;
        let b = demo_box(qid / 6);
        return box_face_vertex(b, qid % 6, cid);
    }
}

kernel rt_demo.tris@1 {
    requires { field.write; }
    output result: Rows<TraceTriangle>;

    compute {
        let tid = element();
        let base = (tid / 2) * 4;
        return if (tid & 1) == 0 {
            TraceTriangle { a: base, b: base + 1, c: base + 2 }
        } else {
            TraceTriangle { a: base, b: base + 2, c: base + 3 }
        };
    }
}

kernel rt_demo.faces@1 {
    requires { field.write; }
    output result: Rows<Face>;

    compute {
        let tid = element();
        let base = (tid / 2) * 4;
        return if (tid & 1) == 0 {
            Face { a: base, b: base + 1, c: base + 2 }
        } else {
            Face { a: base, b: base + 2, c: base + 3 }
        };
    }
}

kernel rt_demo.meshes@1 {
    requires { field.write; }
    output result: Rows<TraceMesh>;

    compute {
        return TraceMesh { vertex_offset: 0, vertex_count: 144, triangle_offset: 0, triangle_count: 72 };
    }
}

kernel rt_demo.instances@1 {
    requires { field.write; }
    output result: Rows<TraceInstance>;

    compute {
        return TraceInstance {
            row0: vec4(1.0, 0.0, 0.0, 0.0),
            row1: vec4(0.0, 1.0, 0.0, 0.0),
            row2: vec4(0.0, 0.0, 1.0, 0.0),
            mesh: 0, custom: 0, mask: 1
        };
    }
}

kernel rt_demo.project@1 {
    requires { field.read; field.write; input.read; }
    input verts: Rows<Vec3>;
    input lens_in: Rows<Lens>;
    input taa_state: Rows<RtTaaState>;
    output result: Rows<Corner>;

    compute {
        let vid = element();
        let qid = vid / 4;
        let l = at(lens_in, 0);
        let win = rt_logical_extent(window(), scale());
        let raw_clip = lens_clip(l, win, at(verts, vid), 0.08, 200.0);
        let clip = rt_apply_clip_jitter(raw_clip, at(taa_state, 0).jitter, win);
        return Corner { clip: clip, normal: box_face_normal(qid % 6), uv: vec2(0.5, 0.5) };
    }
}

kernel rt_demo.shade@1 {
    requires { field.read; field.write; time.read; }
    input surface: Grid<Surface>;
    input ao_map: Grid<Vec2 as f16>;
    input rt_sh_hits: Rows<TraceHit>;
    input rt_sh_dims: Rows<Int>;
    input lens_in: Rows<Lens>;
    input sun_in: Rows<Vec3>;
    input taa_state: Rows<RtTaaState>;
    input conc_alb: Grid<Vec4 as unorm8>;
    input conc_nrm: Grid<Vec2 as unorm8>;
    input gran_alb: Grid<Vec4 as unorm8>;
    input gran_nrm: Grid<Vec2 as unorm8>;
    input steel_alb: Grid<Vec4 as unorm8>;
    input steel_nrm: Grid<Vec2 as unorm8>;
    output result: Grid<Vec4 as f16>;

    compute {
        let q = coord();
        let ext = size(surface);
        let l = at(lens_in, 0);
        let sun = at(sun_in, 0);
        let jitter = at(taa_state, 0).jitter;
        let dir = ray(l, q - jitter, ext);
        let s = at(surface, q);
        let t = time();

        if s.id < 0 || s.depth >= 0.99999 {
            let sky = rt_eval_volumetric_sky(
                dir, sun,
                vec3(2.8, 1.55, 0.72), vec3(0.32, 0.58, 1.35),
                vec3(0.45, 0.28, 0.34), vec3(4.2, 2.4, 1.15),
                -0.06, 0.005, 0.0, t
            );
            return vec4(sky, 200.0);
        }

        let dist = lens_distance(l, dir, s.depth, 0.08, 200.0);
        let world_pos = l.eye + dir * dist;
        let n_geom = rt_safe_norm(s.normal, vec3(0.0, 1.0, 0.0));
        let box_id = clamp((s.id / 2) / 6, 0, 5);
        let mat = demo_box(box_id).mat;

        let fp = rt_compute_footprint(l, q, jitter, ext, world_pos, n_geom, dir, dist, 0.08, 200.0);
        let sc = if mat == 0 { 0.45 } else if mat == 1 { 0.85 } else { 0.75 };
        let uv = rt_box_uv(world_pos, n_geom, sc);
        let ddx = rt_box_duv(fp.p_dx, n_geom, sc);
        let ddy = rt_box_duv(fp.p_dy, n_geom, sc);

        let sz = size(conc_alb);
        let alb_r = if mat == 0 {
            at_repeat(conc_alb, uv * sz, ddx * sz, ddy * sz)
        } else if mat == 1 {
            at_repeat(gran_alb, uv * sz, ddx * sz, ddy * sz)
        } else {
            at_repeat(steel_alb, uv * sz, ddx * sz, ddy * sz)
        };
        let n_xy = if mat == 0 {
            at_repeat(conc_nrm, uv * sz, ddx * sz, ddy * sz)
        } else if mat == 1 {
            at_repeat(gran_nrm, uv * sz, ddx * sz, ddy * sz)
        } else {
            at_repeat(steel_nrm, uv * sz, ddx * sz, ddy * sz)
        };
        let n = rt_apply_tangent_normal(n_geom, rt_unpack_normal(n_xy, 1.25));

        let ao_c = at_linear(ao_map, (q + 0.5) / ext * size(ao_map));
        let rt_lit = rt_sample_shadow_hits(rt_sh_hits, q, ext, at(rt_sh_dims, 1), at(rt_sh_dims, 2));
        let shadow = min(rt_lit, ao_c.y);

        let ndl = max(dot(n, sun), 0.0);
        let hv = rt_safe_norm(sun - dir, vec3(0.0, 1.0, 0.0));
        let spec_p = mix(64.0, 12.0, alb_r.w);
        let spec = pow(max(dot(n, hv), 0.0001), spec_p) * (0.35 + (if mat == 2 { 0.85 } else { 0.0 })) * shadow;

        let sun_c = vec3(4.8, 2.75, 1.35);
        let sky_c = mix(vec3(0.22, 0.19, 0.18), vec3(0.75, 0.88, 1.22), n.y * 0.5 + 0.5) * ao_c.x;
        let wave = rt_eval_world_wave(world_pos, n_geom, vec3(0.0, 0.5, -4.5), 4.6 + mod(t * 2.2, 12.0), 1.0, t);
        let wave_glow = vec3(0.55, 3.8, 2.8) * wave.topo_glow;

        let col = alb_r.xyz * (sun_c * (ndl * shadow) + sky_c) + sun_c * spec + wave_glow;
        return vec4(max(col, vec3(0.0, 0.0, 0.0)), dist);
    }
}
