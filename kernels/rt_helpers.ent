// Multi-Mesh Hardware Ray Tracing (`native.trace@2`) & HiDPI `scale()` Helpers!
// Built for GPU indirect ray compaction and zero-stall dynamic TLAS reuse.
use "random.entpkg";
use "geometry.entpkg";
use "raster.entpkg";
use "taa.ent";
use "gtao.ent";

fn rt_invalid_ray() -> TraceRay {
    return TraceRay { origin: vec3(0.0, 0.0, 0.0), tmin: -1.0, dir: vec3(0.0, 1.0, 0.0), tmax: 0.0 };
}

// Logical HiDPI-aware render extent (`window() / max(scale(), 1.0)`), keeping 1:1 native pixels on 100% DPI
// and exact native aspect ratio at smooth 80-120+ FPS on 150%/200% HiDPI laptop/4K screens!
fn rt_logical_extent(win: Vec2, dpi_scale: Float) -> Vec2 {
    return max(ceil(win / max(dpi_scale, 1.0)), vec2(1.0, 1.0));
}

// Smooth 2x2 bilinear lookup over capped half-res `native.trace@2` shadow hits (`triangle < 0` => lit).
fn rt_sample_shadow_hits(hits: Rows<TraceHit>, q: Vec2, full_ext: Vec2, rt_w: Int, rt_h: Int) -> Float {
    let w = max(rt_w, 1);
    let h = max(rt_h, 1);
    let rt_ext = vec2(float(w), float(h));
    let rt_f = (q + 0.5) / max(full_ext, vec2(1.0, 1.0)) * rt_ext - vec2(0.5, 0.5);
    let rx0 = clamp(int(floor(rt_f.x)), 0, w - 1);
    let ry0 = clamp(int(floor(rt_f.y)), 0, h - 1);
    let rx1 = min(rx0 + 1, w - 1);
    let ry1 = min(ry0 + 1, h - 1);
    let fx = saturate(rt_f.x - float(rx0));
    let fy = saturate(rt_f.y - float(ry0));
    let n_hits = max(count(hits) - 1, 0);
    let h00 = if at(hits, clamp(ry0 * w + rx0, 0, n_hits)).triangle < 0 { 1.0 } else { 0.0 };
    let h10 = if at(hits, clamp(ry0 * w + rx1, 0, n_hits)).triangle < 0 { 1.0 } else { 0.0 };
    let h01 = if at(hits, clamp(ry1 * w + rx0, 0, n_hits)).triangle < 0 { 1.0 } else { 0.0 };
    let h11 = if at(hits, clamp(ry1 * w + rx1, 0, n_hits)).triangle < 0 { 1.0 } else { 0.0 };
    return mix(mix(h00, h10, fx), mix(h01, h11, fx), fy);
}

// Copies a `Lens` row so sub-graphs can retain the previous frame's lens via `<~`.
kernel rt_cinema.same_lens@1 {
    requires { field.read; field.write; }
    input lens_in: Rows<Lens>;
    output result: Rows<Lens>;

    compute {
        return at(lens_in, 0);
    }
}

// Capped half-resolution RT grid dimensions `[w * h, w, h]` derived purely on CPU from HiDPI
// logical extent * `render_scale` (zero GPU readback sync stall, full DRS support via `render_scale`!).
kernel rt_cinema.rt_dims@1 {
    requires { field.write; input.read; }
    param max_w: Int = 960;
    param max_h: Int = 600;
    param render_scale: Float = 1.0;
    output result: Rows<Int>;

    compute {
        let rwin = max(ceil(rt_logical_extent(window(), scale()) * max(render_scale, 0.1)), vec2(1.0, 1.0));
        let w = clamp(int(ceil(rwin.x / 2.0)), 1, max(max_w, 1));
        let h = clamp(int(ceil(rwin.y / 2.0)), 1, max(max_h, 1));
        let i = element();
        return if i == 0 { w * h } else if i == 1 { w } else { h };
    }
}

// Resolution-independent capped half-resolution RT grid dimensions `[w * h, w, h]` derived
// directly from `size(surface)` — stays locked to arbitrary custom or dynamic render scales (DRS)!
kernel rt_cinema.rt_dims_of@1 {
    requires { field.read; field.write; }
    input surface: Grid<Surface>;
    param max_w: Int = 960;
    param max_h: Int = 600;
    output result: Rows<Int>;

    compute {
        let ext = max(size(surface), vec2(1.0, 1.0));
        let w = clamp(int(ceil(ext.x / 2.0)), 1, max(max_w, 1));
        let h = clamp(int(ceil(ext.y / 2.0)), 1, max(max_h, 1));
        let i = element();
        return if i == 0 { w * h } else if i == 1 { w } else { h };
    }
}

// Initial miss rows for `<~` feedback on `native.trace@2` live probe passes.
kernel rt_cinema.rt_probe_init@1 {
    requires { field.write; }
    output result: Rows<TraceHit>;

    compute {
        return trace_miss();
    }
}

// 4-ray interactive world probes: 0 = center gaze, 1 = straight down, 2 = straight up, 3 = lower-ahead!
kernel rt_cinema.rt_gaze_probes@1 {
    requires { field.read; field.write; }
    input lens_in: Rows<Lens>;
    param max_dist: Float = 220.0;
    output result: Rows<TraceRay>;

    compute {
        let i = element();
        let l = at(lens_in, 0);
        if i == 0 {
            return TraceRay { origin: l.eye, tmin: 0.35, dir: l.ahead, tmax: max_dist };
        }
        if i == 1 {
            return TraceRay { origin: l.eye, tmin: 0.1, dir: vec3(0.0, -1.0, 0.0), tmax: 40.0 };
        }
        if i == 2 {
            return TraceRay { origin: l.eye, tmin: 0.2, dir: vec3(0.0, 1.0, 0.0), tmax: 40.0 };
        }
        return TraceRay { origin: l.eye, tmin: 0.25, dir: normalize(l.ahead + vec3(0.0, -0.22, 0.0)), tmax: 60.0 };
    }
}

// Capped half-res soft sun shadow rays with distance-adaptive sun disk radius (`flags = 1` any-hit).
// Invalid rays (`tmin = -1.0`) are skipped automatically by GPU indirect ray compaction.
kernel rt_cinema.rt_shadow_rays@1 {
    requires { field.read; field.write; time.read; }
    input dims: Rows<Int>;
    input surface: Grid<Surface>;
    input lens_in: Rows<Lens>;
    input sun_in: Rows<Vec3>;
    input taa_state: Rows<RtTaaState>;
    param near: Float = 0.08;
    param far: Float = 265.0;
    param sun_radius_near: Float = 0.012;
    param sun_radius_far: Float = 0.002;
    param max_shadow_dist: Float = 240.0;
    output result: Rows<TraceRay>;

    compute {
        let idx = element();
        let hw = max(at(dims, 1), 1);
        let hh = max(at(dims, 2), 1);
        let hx = float(idx % hw);
        let hy = float(idx / hw);
        let ext = size(surface);
        let q = clamp((vec2(hx, hy) + 0.5) / vec2(float(hw), float(hh)) * ext - 0.5, vec2(0.0, 0.0), ext - vec2(1.0, 1.0));
        let s = at(surface, q);
        if s.id < 0 || s.depth >= 0.99999 {
            return rt_invalid_ray();
        }

        let l = at(lens_in, 0);
        let jitter = at(taa_state, 0).jitter;
        let dir = ray(l, q - jitter, ext);
        let raw_n = rt_safe_norm(s.normal, vec3(0.0, 1.0, 0.0));
        let n_geom = if dot(raw_n, -dir) >= 0.0 { raw_n } else { -raw_n };
        let sun = rt_safe_norm(at(sun_in, 0), vec3(0.36, 0.64, -0.677));
        if dot(n_geom, sun) <= 0.01 {
            return rt_invalid_ray();
        }

        let dist = lens_distance(l, dir, s.depth, near, far);
        let world_pos = l.eye + dir * dist;
        let t = time();
        let su = rt_safe_norm(cross(vec3(0.0, 1.0, 0.0), sun), vec3(1.0, 0.0, 0.0));
        let sv = cross(sun, su);
        let n1 = fract(interleaved_noise(vec2(hx, hy)) + fract(t * 1.618034) * 0.754877);
        let n2 = fract(interleaved_noise(vec2(hx, hy) + vec2(37.0, 19.0)) + fract(t * 2.618034) * 0.569840);
        let r_d = sqrt(n1) * mix(sun_radius_near, sun_radius_far, smoothstep(40.0, 100.0, dist));
        let a_d = n2 * 6.283185;
        let r_dir = normalize(sun + su * (cos(a_d) * r_d) + sv * (sin(a_d) * r_d));

        let eps = clamp(0.045 + dist * 0.0018, 0.045, 0.35);
        return TraceRay { origin: world_pos + n_geom * eps + sun * 0.04, tmin: 0.02, dir: r_dir, tmax: max_shadow_dist };
    }
}
